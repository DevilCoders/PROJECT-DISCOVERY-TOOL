# Normalize text to LF in the repository and in every checkout, so byte-exact tests
# and fixtures behave identically on Windows, Linux and macOS.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tgz binary
*.pdf binary
*.docx binary
*.sqlite3 binary
*.pyd binary
*.so binary
